{
  "info": {
    "name": "addon-chat",
    "description": "Postman tests for addon/remsana-web chat (chatApi, insiderChatApi). SME endpoints use sme_access_token; Admin endpoints use insider_access_token. Via engagement service port 4000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "chat_base", "value": "http://localhost:4000"},
    {"key": "sme_access_token", "value": ""},
    {"key": "insider_access_token", "value": ""},
    {"key": "conversationId", "value": ""},
    {"key": "msgId", "value": ""}
  ],
  "auth": {"type": "noauth"},
  "item": [
    {
      "name": "SME - Chat",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{chat_base}}/health",
            "description": "Health check. No auth required.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{sme_access_token}}"}],
            "url": "{{chat_base}}/chat/conversations",
            "description": "List my conversations.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Create Conversation",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{sme_access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket_id\": \"optional-ticket-uuid\"\n}"
            },
            "url": "{{chat_base}}/chat/conversations",
            "description": "Create or get existing conversation. Optional ticket_id to link to support ticket. Set conversationId from response.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status is 2xx', () => pm.response.to.have.status(200));",
                    "const j = pm.response.json();",
                    "const id = j.id || j.data?.id || j.conversation_id;",
                    "if (id) pm.collectionVariables.set('conversationId', id);"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          }
        },
        {
          "name": "Get Conversation",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{sme_access_token}}"}],
            "url": "{{chat_base}}/chat/conversations/{{conversationId}}",
            "description": "Get conversation with messages.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{sme_access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello, I need help with my registration.\",\n  \"type\": \"text\"\n}"
            },
            "url": "{{chat_base}}/chat/conversations/{{conversationId}}/messages",
            "description": "Send text message. Set msgId from response for Mark Read.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test('Status is 2xx', () => pm.response.to.have.status(200));",
                    "const j = pm.response.json();",
                    "const id = j.id || j.data?.id || j.msg_id;",
                    "if (id) pm.collectionVariables.set('msgId', id);"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          }
        },
        {
          "name": "Upload File/Image",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{sme_access_token}}"}],
            "body": {
              "mode": "formdata",
              "formdata": [{"key": "file", "type": "file", "src": ""}]
            },
            "url": "{{chat_base}}/chat/conversations/{{conversationId}}/upload",
            "description": "Upload file or image. Use form-data with key 'file'.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Mark Message Read",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{sme_access_token}}"}],
            "url": "{{chat_base}}/chat/conversations/{{conversationId}}/messages/{{msgId}}/read",
            "description": "Mark admin message as read.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        }
      ]
    },
    {
      "name": "Admin - Chat",
      "item": [
        {
          "name": "List All Conversations",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{insider_access_token}}"}],
            "url": "{{chat_base}}/chat/admin/conversations",
            "description": "List all conversations. Requires: Bearer token (Insider, ADMIN).",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Get Conversation",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{insider_access_token}}"}],
            "url": "{{chat_base}}/chat/admin/conversations/{{conversationId}}",
            "description": "Get conversation with messages.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{insider_access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"We are here to help. Can you provide more details?\",\n  \"type\": \"text\"\n}"
            },
            "url": "{{chat_base}}/chat/admin/conversations/{{conversationId}}/messages",
            "description": "Send admin reply.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Upload File/Image",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{insider_access_token}}"}],
            "body": {
              "mode": "formdata",
              "formdata": [{"key": "file", "type": "file", "src": ""}]
            },
            "url": "{{chat_base}}/chat/admin/conversations/{{conversationId}}/upload",
            "description": "Upload file or image.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Mark Message Read",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Authorization", "value": "Bearer {{insider_access_token}}"}],
            "url": "{{chat_base}}/chat/admin/conversations/{{conversationId}}/messages/{{msgId}}/read",
            "description": "Mark user message as read.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        }
      ]
    }
  ]
}
