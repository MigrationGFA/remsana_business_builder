{
  "info": {
    "name": "addon-dynamic-data-replacement",
    "description": "Postman tests for addon-dynamic-data-replacement: Loans, Dashboard, Admin Dashboard (replaces mock data). SME endpoints require sme_access_token. Admin endpoints require insider_access_token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "core_base", "value": "http://localhost:8080"},
    {"key": "sme_access_token", "value": ""},
    {"key": "insider_access_token", "value": ""}
  ],
  "auth": {"type": "noauth"},
  "item": [
    {
      "name": "SME - Dashboard",
      "item": [
        {
          "name": "Get Dashboard (Me)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{sme_access_token}}"}],
            "url": "{{core_base}}/api/v1/dashboard/me",
            "description": "Get SME dashboard: registrationStatus, learningProgress, certificates, recentActivity, recommendedResources.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        }
      ]
    },
    {
      "name": "SME - Loans",
      "item": [
        {
          "name": "Check Eligibility",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{sme_access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nin\": \"12345678901\",\n  \"monthlyIncome\": \"50-100k\",\n  \"employmentType\": \"self_employed\"\n}"
            },
            "url": "{{core_base}}/api/v1/loans/eligibility",
            "description": "Check loan eligibility. nin: 11 digits. monthlyIncome: 50k|50-100k|100-250k|250-500k|500k+. employmentType: self_employed|employed|business_owner.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Get Offers",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{sme_access_token}}"}],
            "url": "{{core_base}}/api/v1/loans/offers",
            "description": "Get available loan offers.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Apply for Loan",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{sme_access_token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerId\": \"offer_uuid_from_get_offers\",\n  \"nin\": \"12345678901\",\n  \"monthlyIncome\": \"50-100k\",\n  \"employmentType\": \"self_employed\"\n}"
            },
            "url": "{{core_base}}/api/v1/loans/apply",
            "description": "Apply for a loan. offerId from getOffers response.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Get My Application",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{sme_access_token}}"}],
            "url": "{{core_base}}/api/v1/loans/me",
            "description": "Get current user's loan application status.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        }
      ]
    },
    {
      "name": "Admin - Dashboard",
      "item": [
        {
          "name": "Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{insider_access_token}}"}],
            "url": "{{core_base}}/api/insider/admin/dashboard/summary",
            "description": "Admin quick stats: activeUsers, mrr, registrations, avgNps.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        },
        {
          "name": "Alerts",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{insider_access_token}}"}],
            "url": "{{core_base}}/api/insider/admin/alerts",
            "description": "Priority alerts for admin dashboard.",
            "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
          }
        }
      ]
    }
  ]
}
