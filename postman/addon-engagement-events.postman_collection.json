{
  "info": {
    "name": "addon-engagement-events",
    "description": "Postman tests for remsana-engagement-service: lesson-completed, quiz-completed, certificate-issued. These events are triggered by Core API (EngagementService.php) when Learning patch is applied. Optional Bearer token for lesson-completed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "engagement_base", "value": "http://localhost:4000"},
    {"key": "sme_access_token", "value": ""}
  ],
  "auth": {"type": "noauth"},
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{engagement_base}}/health",
        "description": "Health check. No auth required.",
        "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
      }
    },
    {
      "name": "Lesson Completed",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{sme_access_token}}", "description": "Optional"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"user_uuid\",\n  \"lessonId\": \"lesson_uuid\"\n}"
        },
        "url": "{{engagement_base}}/events/lesson-completed",
        "description": "Triggered when user completes lesson. Core API EngagementService calls this. Optional Bearer for Core API fetch.",
        "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
      }
    },
    {
      "name": "Quiz Completed",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"user_uuid\",\n  \"quizId\": \"quiz_uuid\",\n  \"passed\": true,\n  \"score\": 85\n}"
        },
        "url": "{{engagement_base}}/events/quiz-completed",
        "description": "Triggered when user completes quiz. Core API EngagementService calls this. No auth required.",
        "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
      }
    },
    {
      "name": "Certificate Issued",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"user_uuid\",\n  \"certificateId\": \"cert_uuid\",\n  \"title\": \"100-Day SME Mastery Certificate\"\n}"
        },
        "url": "{{engagement_base}}/events/certificate-issued",
        "description": "Triggered when certificate is issued. Core API EngagementService calls this. No auth required.",
        "event": [{"listen": "test", "script": {"exec": ["pm.test('Status is 2xx', () => pm.response.to.have.status(200));"], "type": "text/javascript"}}]
      }
    }
  ]
}
